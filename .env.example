# Copy to .env and choose credentials for the Compose-owned PostgreSQL service.
# Application containers always connect to db:5432. These PGHOST/PGPORT values
# are used only when running GameDB commands directly on the host.
# On a development workstation, uncomment COMPOSE_FILE and point PGHOST at the
# tower; plain `docker compose` commands will then use compose.dev.yaml instead.
# COMPOSE_FILE=compose.dev.yaml
PGHOST=127.0.0.1
PGPORT=9876
PGDATABASE=gamedb
PGUSER=gamedb
PGPASSWORD=change-me

# Optional host ports.
GAMEDB_POSTGRES_PORT=9876
GAMEDB_EXPLORER_PORT=8000
GAMEDB_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Enable only on a trusted local explorer; compose.dev.yaml enables this.
# GAMEDB_ENABLE_CORRECTIONS=1

# Direct host commands may override these. Compose uses its mounted paths.
# GAMEDB_LIBRETRO_THUMBNAILS=/srv/docker/gamedb/data/libretro-thumbnails
# GAMEDB_LIBRETRO_DATABASE=/srv/docker/gamedb/data/libretro-database
# GAMEDB_MEDIA_INDEX=/srv/docker/gamedb/data/media/cache/libretro-thumbnail-index.paths.gz
# GAMEDB_MEDIA_USERNAME=default
# GAMEDB_INTEGRATED_ROOT=/mnt/synology/backup/games/Undub
# GAMEDB_ROM_ROOT=/mnt/synology

# Optional: required only for the Compose "public" profile.
CLOUDFLARED_TOKEN=

# LaunchBox images are fetched only when requested and retained here.
GAMEDB_LAUNCHBOX_IMAGE_CACHE=/data/media/launchbox

# Optional soundtrack serving. This adds media routes to this Explorer instance.
# For Compose use /mnt/vgm and set the host source path if it differs from the default.
# GAMEDB_VGM_ROOT=/mnt/vgm
# GAMEDB_VGM_HOST_ROOT="/mnt/synology/music/VGM/By Format"

# Host Explorer reads the manual library directly. Compose mounts it read-only.
# GAMEDB_SNES_MANUAL_ROOT=/mnt/synology/photo/Manuals/SNES
# GAMEDB_SNES_MANUAL_HOST_ROOT=/mnt/synology/photo/Manuals/SNES
# GAMEDB_MEGADRIVE_MANUAL_ROOT="/mnt/synology/photo/Manuals/Mega Drive"
# GAMEDB_MEGADRIVE_MANUAL_HOST_ROOT="/mnt/synology/photo/Manuals/Mega Drive"
# GAMEDB_NES_MANUAL_ROOT=/mnt/synology/photo/Manuals/NES
# GAMEDB_NES_MANUAL_HOST_ROOT=/mnt/synology/photo/Manuals/NES
# GAMEDB_NEOGEO_MANUAL_ROOT="/mnt/synology/photo/Manuals/Neo Geo"
# GAMEDB_NEOGEO_MANUAL_HOST_ROOT="/mnt/synology/photo/Manuals/Neo Geo"

# Optional override for the patch library when running Explorer directly.
# GAMEDB_SNES_TRANSLATION_ROOT=/path/to/snes-translations
# GAMEDB_MEGADRIVE_TRANSLATION_ROOT=/path/to/megadrive-translations
# GAMEDB_MASTERSYSTEM_MANUAL_HOST_ROOT=/path/to/master-system-manuals
# GAMEDB_MASTERSYSTEM_TRANSLATION_ROOT=/path/to/master-system-translations
# GAMEDB_NEOGEO_TRANSLATION_ROOT=/path/to/neogeo-translations
# GAMEDB_PCENGINE_MANUAL_HOST_ROOT=/path/to/pc-engine-manuals
# GAMEDB_PCENGINE_TRANSLATION_ROOT=/path/to/pc-engine-translations
# GAMEDB_N64_MANUAL_HOST_ROOT=/path/to/nintendo-64-manuals
# GAMEDB_N64_TRANSLATION_ROOT=/path/to/nintendo-64-translations
# GAMEDB_SATURN_MANUAL_HOST_ROOT=/path/to/saturn-manuals
# GAMEDB_JAGUAR_MANUAL_HOST_ROOT=/path/to/jaguar-manuals
# GAMEDB_PCFX_MANUAL_HOST_ROOT=/path/to/pcfx-manuals
# GAMEDB_CD32_MANUAL_HOST_ROOT=/path/to/cd32-manuals
# GAMEDB_3DO_MANUAL_HOST_ROOT=/path/to/3do-manuals
# GAMEDB_SATURN_TRANSLATION_ROOT=/path/to/saturn-translations
# GAMEDB_NES_TRANSLATION_ROOT=/path/to/nes-translations
