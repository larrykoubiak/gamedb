# Copy to .env and choose credentials for the Compose-owned PostgreSQL service.
# Application containers always connect to db:5432. These PGHOST/PGPORT values
# are used only when running GameDB commands directly on the host.
# On a development workstation, uncomment COMPOSE_FILE and point PGHOST at the
# tower; plain `docker compose` commands will then use compose.dev.yaml instead.
# COMPOSE_FILE=compose.dev.yaml
PGHOST=127.0.0.1
PGPORT=9876
PGDATABASE=gamedb
PGUSER=gamedb
PGPASSWORD=change-me

# Optional host ports.
GAMEDB_POSTGRES_PORT=9876
GAMEDB_EXPLORER_PORT=8000

# Optional: required only for the Compose "public" profile.
CLOUDFLARED_TOKEN=
