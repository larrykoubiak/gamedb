# Copy to .env and fill in your database connection.
# The CLI loads .env automatically; exported variables take precedence.
PGHOST=postgres.example.internal
PGPORT=5432
PGDATABASE=gamedb
PGUSER=gamedb
PGPASSWORD=change-me

# Optional legacy web services.
CLOUDFLARED_TOKEN=
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*
