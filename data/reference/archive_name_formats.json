{
  "version": 1,
  "collections": {
    "No-Intro": {
      "boundary": {
        "kind": "region",
        "vocabulary": "no_intro_regions",
        "additional_values": ["Unknown"]
      },
      "leading_tags": ["[]"]
    },
    "Redump": {
      "boundary": {
        "kind": "region",
        "vocabulary": "redump_regions",
        "additional_values": ["Unknown"]
      },
      "leading_tags": []
    },
    "TOSEC": {
      "boundary": {
        "kind": "sequence",
        "groups": [
          {"delimiter": "()", "pattern": "^[12][0-9xX]{3}(?:-[0-9xX]{2}){0,2}$"},
          {"delimiter": "()"}
        ]
      },
      "prefix_tags": [
        {"name": "demo", "delimiter": "()", "pattern": "^demo(?:-[^()]*)?$", "ignore_case": true},
        {"name": "version", "pattern": "(?:v\\d[\\w.+-]*|rev(?:ision)?\\.?\\s+[A-Za-z0-9][\\w.+-]*)", "ignore_case": true}
      ],
      "record_separator": " & ",
      "ignore_prefixes": ["ZZZ-UNK-"],
      "leading_tags": []
    },
    "TOSEC-ISO": {
      "inherits": "TOSEC"
    }
  }
}
